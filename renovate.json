{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>hairihou/renovate-config", "group:allNonMajor"],
  "assignees": ["hairihou"],
  "automerge": true,
  "draftPR": false,
  "major": {
    "automerge": false
  },
  "rebaseWhen": "conflicted",
  "schedule": ["before 8:00", "after 12:00"],
  "packageRules": [
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["tmux"],
      "versioning": "loose"
    }
  ]
}
